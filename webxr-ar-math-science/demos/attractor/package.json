{
  "name": "webxr-attractor",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --open /index.dev.html",
    "build": "vite build && npm run sync:deploy",
    "sync:deploy": "rm -rf assets static && cp -R dist/assets assets && if [ -d dist/static ]; then cp -R dist/static static; fi",
    "preview": "vite preview --host"
  },
  "devDependencies": {
    "vite": "^4.5.2"
  },
  "dependencies": {
    "gsap": "^3.12.5",
    "three": "^0.162.0",
    "three-custom-shader-material": "^5.4.0",
    "vite-plugin-glsl": "^1.2.1"
  },
  "description": "WebXR demo: attractor"
}
